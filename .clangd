# Primary source of flags is compile_commands.json at the repo root,
# regenerated by tools/gen-compile-commands.sh. These settings apply on
# top of it, and keep clangd usable if the database is missing or stale.

CompileFlags:
  CompilationDatabase: .
  Add:
    - -std=c++17
    - -Wall
    - -Wextra
    # Treat plain // comments as documentation so hover and go-to-def show
    # the contract notes in the headers without converting them to ///.
    - -fparse-all-comments
  Remove:
    - -march=*

Diagnostics:
  # Nothing is defined yet, so unused-parameter noise on declarations is
  # not informative. Drop this block once implementations land.
  Suppress:
    - unused-parameter
  UnusedIncludes: Strict
  MissingIncludes: Strict

Index:
  Background: Build
  StandardLibrary: Yes

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Hover:
  ShowAKA: Yes
